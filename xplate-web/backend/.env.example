# Telegram alert delivery. Values may alternatively be saved through Settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduler/report timezone.
TZ=Asia/Dubai

# Optional: pin each successfully sent daily rule workbook in Telegram.
# Defaults to false when omitted.
TELEGRAM_PIN_DAILY_REPORTS=true

# Deployed frontend origin for CORS, for example:
# FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_URL=
