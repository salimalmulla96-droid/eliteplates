# Xplate Scout - Environment Configuration Example
# Copy this file to .env and update values as needed

# ============================================================================
# TELEGRAM CONFIGURATION
# ============================================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_channel_id_here

# ============================================================================
# DUPLICATE DETECTION & COOLDOWN SETTINGS
# ============================================================================

# Cooldown period preset (20s, 30s, 1m, 5m, 7m, 10m, 30m, 1h, 2h, 6h, 1d)
# Default: 7m (7 minutes) - prevents sending same plate more than once per 7 minutes
DUPLICATE_COOLDOWN_PRESET=7m

# OR use custom seconds value (overrides preset if set)
# Example: 300 = 5 minutes, 600 = 10 minutes, 3600 = 1 hour
# DUPLICATE_COOLDOWN_SECONDS=420

# ============================================================================
# PLATE TRACKING & DATABASE
# ============================================================================

# Enable/disable plate tracking database (true/false)
ENABLE_PLATE_TRACKING=true

# Enable/disable duplicate message prevention (true/false)
ENABLE_DEDUP_MESSAGES=true

# Include release count in Telegram messages (true/false)
INCLUDE_RELEASE_COUNT=true

# Number of days to keep plate records before auto-cleanup
CLEANUP_OLD_PLATES_DAYS=30

# ============================================================================
# TELEGRAM RETRY SETTINGS
# ============================================================================

# Maximum number of retry attempts for failed Telegram sends
MAX_ALERT_RETRIES=3

# Delay between retry attempts in seconds
RETRY_DELAY_SECONDS=5

# ============================================================================
# PRESET EXAMPLES (uncomment to use)
# ============================================================================

# High-frequency alerts (every 20 seconds - NOT RECOMMENDED)
# DUPLICATE_COOLDOWN_PRESET=20s

# Frequent alerts (every 5 minutes)
# DUPLICATE_COOLDOWN_PRESET=5m

# Default balanced (every 7 minutes) - RECOMMENDED
# DUPLICATE_COOLDOWN_PRESET=7m

# Relaxed alerts (every 30 minutes)
# DUPLICATE_COOLDOWN_PRESET=30m

# Very relaxed (once per hour)
# DUPLICATE_COOLDOWN_PRESET=1h

# Once per day
# DUPLICATE_COOLDOWN_PRESET=1d

# ============================================================================
# NOTES
# ============================================================================

# HOW DUPLICATE DETECTION WORKS:
# 1. When a plate is first seen (e.g., Dubai V 51115 at 10:24), it's sent immediately
# 2. If the same plate appears again within the cooldown period (10:26), it's SKIPPED
# 3. After cooldown expires, it's sent again (12:57+), with release counter increased
# 4. Cooldown resets after each successful send

# TELEGRAM MESSAGE FORMAT:
# - First send: "🚨 New Plate Published"
# - Subsequent sends: "🚨 Plate Released Again" + "🔁 Total Releases Seen: X"

# DATABASE CLEANUP:
# - Plates not seen in CLEANUP_OLD_PLATES_DAYS days are auto-deleted
# - Run manual cleanup: POST /api/admin/plate-tracking/cleanup?days=30
# - Reset all tracking: POST /api/admin/plate-tracking/reinit-db (WARNING: deletes all)

# TEST THE SYSTEM:
# 1. Check stats: GET http://127.0.0.1:8000/api/admin/plate-stats
# 2. Check config: GET http://127.0.0.1:8000/api/admin/config
# 3. View logs: GET http://127.0.0.1:8000/api/alerts/logs
